{
  "entities": {
    "Message": {
      "title": "Contact Message",
      "description": "A message submitted through the contact form.",
      "type": "object",
      "properties": {
        "first_name": { "type": "string", "maxLength": 100 },
        "last_name": { "type": "string", "maxLength": 100 },
        "user_email": { "type": "string", "maxLength": 200, "format": "email" },
        "message": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "timestamp", "description": "The time the message was created" }
      },
      "required": ["first_name", "user_email", "message", "createdAt"]
    }
  },
  "firestore": {
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Stores contact messages from visitors."
    }
  }
}
